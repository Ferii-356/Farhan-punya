rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return request.auth.uid == uid;
    }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    match /users/{uid} {
      allow read: if isLoggedIn();
      allow write: if role() == 'admin';
    }

    match /config/lokasi_pkl {
      allow read: if isLoggedIn();
      allow write: if role() == 'admin';
    }

    match /absensi_log/{id} {
      allow read: if role() in ['admin', 'pembimbing'] || isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid);
      allow update, delete: if role() == 'admin';
    }

    match /posisi_terakhir/{uid} {
      allow read, write: if isOwner(uid) || role() in ['admin', 'pembimbing'];
    }
  }
}