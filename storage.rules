rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Foto absen dikelompokkan per uid: absensi_foto/{uid}/{timestamp}.jpg
    match /absensi_foto/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 5 * 1024 * 1024; // max 5MB per file
      allow update, delete: if false; // foto absen tidak boleh diubah/dihapus dari client
    }
  }
}
